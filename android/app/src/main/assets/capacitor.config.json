{
	"appId": "com.tajweedai.app",
	"appName": "TajweedAI",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": false
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"backgroundColor": "#064e3b",
			"showSpinner": false,
			"androidScaleType": "CENTER_CROP"
		}
	}
}
